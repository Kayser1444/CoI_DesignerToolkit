<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <DefineConstants>$(DefineConstants);COI_UPDATE_4_3</DefineConstants>
    <ManagedPath Condition="'$(ManagedPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Captain of Industry\Captain of Industry_Data\Managed</ManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mafi"><HintPath>$(ManagedPath)\Mafi.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mafi.Core"><HintPath>$(ManagedPath)\Mafi.Core.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="../../external/CoI_AutoHelpers/src/CoI.AutoHelpers/Compatibility/PlainProductBufferAdapter.cs" Link="PlainProductBufferAdapter.cs" />
  </ItemGroup>
</Project>
